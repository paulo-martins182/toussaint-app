---
import BaseLayout from "../layouts/BaseLayout.astro";
import OrbScene from "../components/OrbScene.astro";
---

<BaseLayout
  title="Toussaint / 006 — A noite se revela"
  description="Uma experiência editorial responsiva de lançamento: direção de arte, Three.js e frontend de alta performance em uma única noite."
>
  <div class="site-shell" id="topo">
    <span class="cursor-dot" data-cursor aria-hidden="true"></span>

    <header class="topbar" aria-label="Navegação principal">
      <a class="wordmark" href="#topo" aria-label="Toussaint, voltar ao início">
        <span class="wordmark__mark" aria-hidden="true"></span>
        <span class="wordmark__name">TOUSSAINT</span>
        <span class="wordmark__id">/ 006</span>
      </a>
      <div class="topbar__signal"><span class="signal-light" aria-hidden="true"></span>Private view <i></i> 2023</div>
      <div class="topbar__actions">
        <a class="topbar__index" href="#manifesto">Index <span>↘</span></a>
        <a class="menu-pill" href="#contact">Menu <span>↗</span></a>
      </div>
    </header>

    <aside class="scroll-rail" aria-hidden="true">
      <span>00</span><i></i><span>04</span>
    </aside>

    <main id="conteudo">
      <section class="hero" id="topo-hero" aria-labelledby="hero-title">
        <div class="hero__wash" aria-hidden="true"></div>
        <div class="hero__grid" aria-hidden="true"></div>
        <div class="hero__topline"><span>01 — 04</span><span>Night / Interface / Presence</span><span>Scroll to enter</span></div>

        <div class="hero__content" data-reveal>
          <p class="hero__overline"><span></span> Lancement nocturne · 31.10 — 01.11</p>
          <h1 class="hero__title" id="hero-title">
            <span>A noite</span>
            <span><em>se</em> revela<span class="hero__period">.</span></span>
          </h1>
          <p class="hero__lede">Um lançamento sem endereço.<br />Uma atmosfera que se move com você.</p>
        </div>

        <div class="hero__orb-shell" data-reveal>
          <OrbScene />
          <div class="hero__orb-tag"><span>ATLAS / 006</span><span>43° 18' 06" N</span></div>
        </div>

        <div class="hero__side-note"><span>Designed in the dark</span><strong>Astro × Three.js × Tailwind</strong></div>
        <a class="hero__scroll" href="#manifesto"><span class="hero__scroll-index">01</span><span>Deslize para entrar</span><span class="hero__scroll-arrow">↓</span></a>
        <div class="hero__edge-word" aria-hidden="true">TOUSSAINT</div>
      </section>

      <div class="marquee" aria-label="Toussaint, uma experiência editorial em movimento">
        <div class="marquee__track">
          <span>A noite se revela</span><b>✳</b><span>Less effect / more presence</span><b>✳</b><span>Scroll into the atmosphere</span><b>✳</b><span>A noite se revela</span><b>✳</b><span>Less effect / more presence</span><b>✳</b>
        </div>
      </div>

      <section class="manifesto section-pad" id="manifesto" aria-labelledby="manifesto-title">
        <div class="section-head"><span>02 / Manifesto</span><span>Read between the lines</span></div>
        <div class="manifesto__layout">
          <p class="manifesto__kicker" data-reveal>O convite<br /><span>não precisa<br />de endereço.</span></p>
          <div class="manifesto__main" data-reveal>
            <h2 id="manifesto-title">Não é uma <em>página.</em><br />É uma entrada.</h2>
            <div class="manifesto__bottom">
              <p>Toussaint é o registro de uma atmosfera: uma página que prefere sugerir a explicar, onde tipografia, espaço e movimento abrem uma fresta para você entrar.</p>
              <a class="text-link" href="#artefato"><span>Ver o artefato</span><i>↘</i></a>
            </div>
          </div>
        </div>
        <div class="manifesto__stamp" aria-hidden="true">006</div>
      </section>

      <section class="artifact-intro" id="artefato" aria-labelledby="artifact-title">
        <div class="artifact-intro__visual" data-reveal>
          <div class="artifact-visual__grid" aria-hidden="true"></div>
          <div class="artifact-visual__orbit artifact-visual__orbit--one" aria-hidden="true"></div>
          <div class="artifact-visual__orbit artifact-visual__orbit--two" aria-hidden="true"></div>
          <div class="artifact-visual__sun" aria-hidden="true"></div>
          <div class="artifact-visual__label"><span>FORM / 01</span><span>OBJECT IN MOTION</span></div>
          <div class="artifact-visual__caption">A quiet signal<br />in a loud world.</div>
        </div>
        <div class="artifact-intro__copy" data-reveal>
          <div class="section-head section-head--dark"><span>03 / O artefato</span><span>Study no. 01</span></div>
          <p class="artifact-intro__eyebrow">A matéria da noite</p>
          <h2 id="artifact-title">Feito para<br /><em>ser sentido.</em></h2>
          <p class="artifact-intro__text">Um objeto orbital em Three.js funciona como a pulsação da interface. Ele não pede atenção — ele deixa uma marca quando você passa.</p>
          <div class="artifact-intro__facts"><span>Low-poly geometry</span><span>170 points / 60 fps intent</span><span>WebGL fallback ready</span></div>
        </div>
      </section>

      <section class="collection section-pad" aria-labelledby="collection-title">
        <div class="section-head"><span>04 / Signals</span><span>Three details worth keeping</span></div>
        <div class="collection__heading">
          <h2 id="collection-title">O que fica<br /><em>quando tudo passa.</em></h2>
          <p>Direção visual não é adicionar mais. É escolher o que merece permanecer.</p>
        </div>
        <div class="artifact-grid">
          <article class="artifact-card artifact-card--rust" data-reveal>
            <span class="artifact-card__number">01</span>
            <div class="artifact-card__shape artifact-card__shape--flare" aria-hidden="true"></div>
            <div class="artifact-card__footer"><strong>Calor controlado</strong><span>RUST / #E8673F</span></div>
          </article>
          <article class="artifact-card artifact-card--paper" data-reveal>
            <span class="artifact-card__number">02</span>
            <div class="artifact-card__shape artifact-card__shape--type" aria-hidden="true">A</div>
            <div class="artifact-card__footer"><strong>Tipografia como gesto</strong><span>PAPER / CORMORANT</span></div>
          </article>
          <article class="artifact-card artifact-card--ash" data-reveal>
            <span class="artifact-card__number">03</span>
            <div class="artifact-card__shape artifact-card__shape--line" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
            <div class="artifact-card__footer"><strong>Silêncio entre linhas</strong><span>ASH / 08:47 PM</span></div>
          </article>
        </div>
      </section>

      <section class="performance-v2" id="performance" aria-labelledby="performance-title">
        <div class="performance-v2__top"><span>05 / Discipline</span><span>Built for the quiet moment</span></div>
        <div class="performance-v2__body">
          <div class="performance-v2__heading" data-reveal>
            <p>Menos efeito.<br /><em>Mais presença.</em></p>
            <div class="performance-v2__score"><strong>100</strong><span>target / lighthouse<br />performance first</span></div>
          </div>
          <div class="performance-v2__list" id="performance-title" aria-label="Decisões de performance">
            <div class="performance-v2__item"><span>01</span><strong>Static by default</strong><b>HTML</b><small>o conteúdo principal chega antes de qualquer efeito</small></div>
            <div class="performance-v2__item"><span>02</span><strong>3D when it matters</strong><b>LAZY</b><small>cena carregada apenas quando se aproxima da viewport</small></div>
            <div class="performance-v2__item"><span>03</span><strong>Motion with consent</strong><b>OPT-IN</b><small>respeito ao ritmo do sistema e de quem está lendo</small></div>
            <div class="performance-v2__item"><span>04</span><strong>Fluid on every screen</strong><b>100%</b><small>uma composição que não depende de uma única proporção</small></div>
          </div>
        </div>
      </section>

      <section class="outro" id="contact" aria-labelledby="outro-title">
        <div class="outro__noise" aria-hidden="true"></div>
        <div class="outro__top"><span>Final chapter</span><span>Keep the door open</span></div>
        <div class="outro__body" data-reveal>
          <p class="outro__eyebrow">Fim do primeiro capítulo</p>
          <h2 id="outro-title">A noite<br /><em>continua.</em></h2>
          <a class="magnetic-button" href="mailto:hello@exemplo.dev?subject=Toussaint%20%2F%20006"><span>Marcar uma conversa</span><i>↗</i></a>
        </div>
        <div class="outro__footer"><span>TOUSSAINT / 006</span><span>© 2023 — sem endereço</span><a href="#topo">Voltar ao início ↑</a></div>
      </section>
    </main>
  </div>

  <script>
    const root = document.documentElement;
    root.dataset.enhanced = "true";

    const revealItems = document.querySelectorAll("[data-reveal]");
    if ("IntersectionObserver" in window) {
      const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            revealObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12, rootMargin: "0px 0px -8%" });
      revealItems.forEach((item) => revealObserver.observe(item));
    } else {
      revealItems.forEach((item) => item.classList.add("is-visible"));
    }

    const progress = document.createElement("span");
    progress.className = "page-progress";
    progress.setAttribute("aria-hidden", "true");
    document.body.append(progress);
    const updateProgress = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      progress.style.transform = `scaleX(${max > 0 ? window.scrollY / max : 0})`;
    };
    updateProgress();
    window.addEventListener("scroll", updateProgress, { passive: true });

    const cursor = document.querySelector<HTMLElement>("[data-cursor]");
    const finePointer = window.matchMedia("(pointer: fine)").matches;
    if (cursor && finePointer) {
      root.dataset.pointer = "fine";
      window.addEventListener("pointermove", (event) => {
        cursor.style.transform = `translate3d(${event.clientX}px, ${event.clientY}px, 0)`;
      }, { passive: true });
      document.querySelectorAll("a, .artifact-card").forEach((element) => {
        element.addEventListener("pointerenter", () => cursor.classList.add("is-hovering"));
        element.addEventListener("pointerleave", () => cursor.classList.remove("is-hovering"));
      });
    }
  </script>
</BaseLayout>
